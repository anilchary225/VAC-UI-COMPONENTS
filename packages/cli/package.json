{
  "name": "vac-ui-components",
  "version": "0.1.0",
  "description": "CLI tool to add and configure VAC UI components in React projects",
  "bin": {
    "vac-ui": "./bin/vac.js",
    "vac-ui-components": "./bin/vac.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/prompts": "^2.4.9",
    "@vac/registry": "workspace:*",
    "@vac/shared": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
