# ==============================================================================
# VAC-UI-COMPONENTS Environment Configuration Example
# Copy this file to .env and adjust values for local development.
# ==============================================================================

# Backend Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB)
# If local MongoDB is not running, the backend will safely warn and run in degraded mode.
MONGODB_URI=mongodb://127.0.0.1:27017/vac_ui_components

# Authentication & Security
JWT_SECRET=vac_ui_super_secret_development_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Initial Admin Bootstrap Token (used only once for protected initial admin provisioning)
ADMIN_BOOTSTRAP_SECRET=bootstrap_vac_admin_secret_key_change_me_2026

# OAuth Providers (Optional in local development)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:4000/api
VITE_APP_NAME=VAC-UI-COMPONENTS
