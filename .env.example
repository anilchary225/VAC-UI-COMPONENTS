# ==============================================================================
# VAC-UI-COMPONENTS Environment Configuration Example
# Copy this file to .env and adjust values for your deployment environment.
# ==============================================================================

# Backend Server Configuration
PORT=4000
NODE_ENV=development
# In production, set to your canonical web app domain, e.g. https://vac-ui.example.com
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB)
# In production, provide a high-availability MongoDB Atlas replica set URI
MONGODB_URI=mongodb://127.0.0.1:27017/vac_ui_components

# Authentication & Security
# WARNING: In production (NODE_ENV=production), JWT_SECRET MUST be a randomly generated
# secret with at least 32 characters (e.g. `openssl rand -hex 32`). The server will reject boot
# if left with the development default.
JWT_SECRET=vac_ui_super_secret_development_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Initial Admin Bootstrap Token
# Used once via POST /api/auth/bootstrap-admin to create the initial admin user.
# In production, set to a strong random token and keep secure.
ADMIN_BOOTSTRAP_SECRET=bootstrap_vac_admin_secret_key_change_me_2026

# Registry Storage Configuration
# Local storage directory path for immutable release manifests and source snapshots.
# In production with containerized deployments (Docker/Kubernetes/ECS), point this to a
# persistent volume mount path (e.g. /var/lib/vac-ui/registry or /mnt/efs/registry).
REGISTRY_STORAGE_DIR=
# Storage driver: 'local', 'memory', 'database', or 's3' (recommended for serverless Vercel)
REGISTRY_STORAGE_DRIVER=local

# S3 Object Storage (Required when REGISTRY_STORAGE_DRIVER=s3 or on serverless / Vercel Functions)
# Compatible with AWS S3, Cloudflare R2, Supabase Storage, MinIO
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=registry/

# OAuth Providers (Optional in local development)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend Configuration (Vite)
# The base URL of the backend API for client-side queries
VITE_API_URL=http://localhost:4000/api
VITE_APP_NAME=VAC-UI-COMPONENTS
